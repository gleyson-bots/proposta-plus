generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum UserRole {
  ADMIN
  VP
  DIRECTOR
  SUPERVISOR
  MANAGER
  BROKER
}

enum ConversationType {
  DIRECT
  TEAM
}

enum AssignmentStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELED
}

model Organization {
  id            String                 @id @default(cuid())
  name          String
  slug          String                 @unique
  users         User[]
  clients       Client[]
  proposals     Proposal[]
  conversations InternalConversation[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
}

model User {
  id                    String                @id @default(cuid())
  organizationId        String
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                   String
  email                  String
  role                   UserRole
  parentId               String?
  parent                 User?                 @relation("UserHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children               User[]                @relation("UserHierarchy")
  directorate            String?
  team                   String?
  isActive               Boolean               @default(true)
  sessions               Session[]
  ownedClients           Client[]              @relation("ClientOwner")
  ownedProposals         Proposal[]            @relation("ProposalOwner")
  conversationMemberships ChatParticipant[]
  messages               InternalMessage[]
  createdConversations   InternalConversation[] @relation("ConversationCreator")
  assignmentsReceived    ChatAssignment[]       @relation("AssignmentAssignee")
  assignmentsCreated     ChatAssignment[]       @relation("AssignmentCreator")
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId, role])
  @@index([parentId])
  @@index([organizationId, directorate])
  @@index([organizationId, team])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerId        String?
  owner          User?        @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  name           String
  company        String?
  email          String?
  phone          String?
  document       String?
  notes          String?
  proposals      Proposal[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, name])
  @@index([ownerId])
}

model Proposal {
  id             String         @id @default(cuid())
  number         Int            @unique @default(autoincrement())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerId        String?
  owner          User?          @relation("ProposalOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  clientId       String
  client         Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  title          String
  status         ProposalStatus @default(DRAFT)
  validUntil     DateTime?
  discount       Decimal        @default(0) @db.Decimal(12, 2)
  notes          String?
  items          ProposalItem[]
  sentAt         DateTime?
  viewedAt       DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, status])
  @@index([clientId])
  @@index([ownerId])
  @@index([createdAt])
}

model ProposalItem {
  id          String   @id @default(cuid())
  proposalId  String
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([proposalId, sortOrder])
}

model InternalConversation {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           ConversationType
  title          String?
  createdById    String
  createdBy      User             @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  participants   ChatParticipant[]
  messages       InternalMessage[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId, updatedAt])
}

model ChatParticipant {
  id             String               @id @default(cuid())
  conversationId String
  conversation   InternalConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  joinedAt       DateTime             @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model InternalMessage {
  id             String               @id @default(cuid())
  conversationId String
  conversation   InternalConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User                 @relation(fields: [senderId], references: [id], onDelete: Restrict)
  body           String
  assignment     ChatAssignment?
  createdAt      DateTime             @default(now())
  editedAt       DateTime?

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model ChatAssignment {
  id           String           @id @default(cuid())
  messageId    String           @unique
  message      InternalMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  assigneeId   String
  assignee     User             @relation("AssignmentAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  assignedById String
  assignedBy   User             @relation("AssignmentCreator", fields: [assignedById], references: [id], onDelete: Restrict)
  status       AssignmentStatus @default(OPEN)
  dueAt        DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([assigneeId, status])
  @@index([assignedById])
}
